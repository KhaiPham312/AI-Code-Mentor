# App configuration
PROJECT_NAME="AI Code Mentor API"
API_V1_STR="/api/v1"
DEBUG=True

# Security & JWT
# IMPORTANT: Generate a strong secret key for production (e.g. `openssl rand -hex 32`)
SECRET_KEY="ai-mentor-super-secret-key-development-mode-only"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite in local development
DATABASE_URL="sqlite:///./database/ai_mentor.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_mentor"

# CORS (Frontend URL origin list - comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# AI Mentor Provider Configuration
AI_PROVIDER="gemini" # gemini | openai | mock
GEMINI_API_KEY=""
OPENAI_API_KEY=""
DEFAULT_AI_MODEL="gemini-1.5-flash"

# Sandbox / Code Execution
CODE_EXEC_TIMEOUT_MS=5000
MAX_OUTPUT_LENGTH_CHARS=10000

# SMTP / Gmail Configuration for Password Reset
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""          # e.g. "your_account@gmail.com"
SMTP_PASSWORD=""      # e.g. "abcd efgh ijkl mnop" (Google App Password)
SMTP_TLS=True
EMAILS_FROM_EMAIL="no-reply@hnue.edu.vn"
EMAILS_FROM_NAME="AI Code Mentor"
FRONTEND_URL="http://localhost:3000"

